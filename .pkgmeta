# BigWigs packager config: https://github.com/BigWigsMods/packager
package-as: BeastTrainingTracker

# Upload the hand-written changelog instead of raw commit messages
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - tests       # unit tests - development only
  - RareData.lua  # local-only copy of RareScanner data (All Rights Reserved) - never ship it
  - Libs/LibDataBroker-1.1/README.textile
  - Libs/LibStub/LibStub.toc
